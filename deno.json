{
  "tasks": {
    "brb": "deno run -A main.ts",
    "install": "deno install -g -f -A --name brb main.ts",
    "check": "deno fmt --check && deno lint && deno check *.ts && deno test -A"
  },
  "imports": { "@std/assert": "jsr:@std/assert@1" },
  "fmt": { "lineWidth": 120 },
  "test": { "include": ["*_test.ts"] }
}
