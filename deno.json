{
  "tasks": {
    "brb": "deno run -A main.ts",
    "build": "deno run -A scripts/build.ts",
    "install": "deno task build && npm install -g .",
    "check": "deno task build && deno fmt --check && deno lint && deno check *.ts scripts/*.ts && deno test -A"
  },
  "imports": { "@std/assert": "jsr:@std/assert@1" },
  "fmt": { "lineWidth": 120 },
  "nodeModulesDir": "none",
  "exclude": ["dist"],
  "test": { "include": ["*_test.ts"] }
}
